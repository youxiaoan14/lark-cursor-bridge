# 飞书自建应用凭证（开发者后台 → 凭证与基础信息）
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# feishu = 飞书（国内），lark = Lark（国际版）
LARK_TENANT=feishu

# Cursor API Key：https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_xxxxxxxxxxxx
CURSOR_MODEL=composer-2.5

# 新会话的默认工作目录，聊天里可用 /cd 切换
WORKSPACE_DIR=C:\Users\Mico\Projects

# 允许使用机器人的用户 open_id，逗号分隔；留空表示不限制（仅限个人机器）
ALLOWED_OPEN_IDS=
